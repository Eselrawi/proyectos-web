# Modo demo: franja, panel abierto en /panel/demo, nada de emails reales, datos que caducan a las 24 h
NEXT_PUBLIC_DEMO=true
# URL pública (QR, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Contacto del botón "Quiero esto para mi restaurante": email o WhatsApp con prefijo (solo dígitos)
NEXT_PUBLIC_CONTACT=
# Contraseña de /admin cuando NEXT_PUBLIC_DEMO=false
ADMIN_PASSWORD=demo
# Almacén compartido (necesario en Vercel; Upstash Redis). Sin esto, pedidos en memoria del proceso
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Email de pedidos (solo fuera de demo)
RESEND_API_KEY=
RESTAURANT_EMAIL=
